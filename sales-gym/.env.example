# Скопируйте в .env и заполните. Файл .env не попадает в git.

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID (узнать у @userinfobot). Несколько — через запятую.
ALLOWED_TG_IDS=

# --- Claude API ---
ANTHROPIC_API_KEY=
# Реплики персонажа (много коротких вызовов)
CLAUDE_MODEL_DIALOG=claude-sonnet-5
# Разбор после сессии (один вызов, нужна точность)
CLAUDE_MODEL_REVIEW=claude-opus-5
# Глубина размышлений модели: low | medium | high
CLAUDE_EFFORT_DIALOG=low
CLAUDE_EFFORT_REVIEW=medium
# Лимит расходов на ИИ в месяц, USD. При 80% — предупреждение, при 100% — стоп.
AI_MONTHLY_BUDGET_USD=10

# --- База данных ---
# Пароль Postgres для docker compose (придумайте любой)
POSTGRES_PASSWORD=change-me
# Для локального запуска без Docker можно не задавать — будет SQLite (local.db).
# В docker compose задаётся автоматически.
# DATABASE_URL=

# --- Прочее ---
TIMEZONE=Asia/Tashkent
# Максимум ваших реплик за сессию, дальше — автоматический разбор
MAX_TURNS=20
